{
  "name": "resume-search-rag",
  "version": "0.1.0",
  "description": "RAG-based resume search API (TypeScript + Express)",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc -p .",
    "start": "node dist/server.js",
    "test": "jest --runInBand",
    "lint": "eslint . --ext .ts"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "express": "^4.18.2",
    "dotenv": "^16.0.0",
    "mongodb": "^5.7.0",
    "pino": "^8.0.0",
    "pino-http": "^8.0.0",
    "express-async-errors": "^3.1.1"
  },
  "devDependencies": {
    "typescript": "^5.3.3",
    "ts-node-dev": "^2.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.3",
    "supertest": "^6.3.3",
    "@types/supertest": "^2.0.12",
    "@types/node": "^20.11.1",
    "eslint": "^8.57.0"
  }
}
